# ---------------------------------------------------------------------------
# Medusa backend environment variables
# ---------------------------------------------------------------------------
# Copy to `.env` for local development. In production these are set in the
# hosting platform's secret manager (Render -> Environment). Never commit a real
# secret to this file.
# ---------------------------------------------------------------------------

# --- CORS -------------------------------------------------------------------
# Comma-separated lists of exact origins allowed to call the API from a browser.
# These are NOT wildcards. Leaving them empty blocks every cross-origin request,
# which silently breaks the storefront and the admin dashboard.
# Include the admin URL in ADMIN_CORS and AUTH_CORS, and the storefront URL in
# STORE_CORS. Add the deployed origins as well as local development origins.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. In production use the host's INTERNAL URL when
# the app and database are in the same private network.
DATABASE_URL=

# --- Redis ------------------------------------------------------------------
# Optional. When present, Medusa uses Redis for the event bus, workflow engine,
# cache and server sessions. When absent it falls back to in-memory
# implementations that drop events on restart and cannot resume workflows, which
# is not safe for unattended operation.
REDIS_URL=

# --- Secrets ----------------------------------------------------------------
# Generate strong, unique values. Do not reuse the placeholders below.
#   openssl rand -base64 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- Payment: PayPal --------------------------------------------------------
# The PayPal provider is only registered when BOTH clientId and clientSecret are
# present, so leaving these blank keeps the store running exactly as before.
# Obtain them from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Set to the literal string "false" to target live PayPal. Anything else
# (including unset) uses the sandbox, so a missing value can never take real
# money.
PAYPAL_SANDBOX=true

# Webhook id from the PayPal app's Webhooks section. Required for inbound
# webhooks to be signature-verified; without it, webhooks are ignored rather
# than trusted.
PAYPAL_WEBHOOK_ID=

# Optional brand name shown on the PayPal approval page.
PAYPAL_BRAND_NAME=King Spirit Store

# --- Payment: Cryptocurrency ------------------------------------------------
# DELIBERATELY ABSENT.
#
# The crypto provider in `src/modules/payment-crypto` is not registered in
# `medusa-config.ts` and therefore never loads. Crypto payments must stay
# inactive until the owner's regulatory reassessment of Trinidad and Tobago's
# requirements is complete (currently expected after 31 December 2026).
#
# Do not add crypto configuration variables here until that sign-off exists.
# See the header of the module for the full activation checklist.
